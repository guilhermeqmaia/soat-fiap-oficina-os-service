{
  "name": "software-architecture-tech-challenge-01",
  "version": "1.1.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "npm run test:unit && npm run test:contracts && npm run test:integration",
    "test:watch": "jest --watch",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:unit:cov": "jest --config jest.unit.config.ts --coverage",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:integration:cov": "jest --config jest.integration.config.ts --coverage",
    "test:contracts": "jest --config jest.contracts.config.ts",
    "test:all:cov": "npm run test:unit:cov && npm run test:integration:cov",
    "test:bdd": "cucumber-js",
    "test:bdd:e2e": "cucumber-js --profile e2e",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/openapi-export.ts",
    "openapi:check": "ts-node -r tsconfig-paths/register scripts/openapi-export.ts --check",
    "contracts:lint": "redocly lint docs/contratos/openapi/os-service.yaml",
    "perf:smoke": "mkdir -p perf-results && k6 run perf/smoke.js",
    "perf:load": "mkdir -p perf-results && k6 run perf/load.js",
    "perf:stress": "mkdir -p perf-results && k6 run perf/stress.js",
    "perf:spike": "mkdir -p perf-results && k6 run perf/spike.js",
    "perf:soak": "mkdir -p perf-results && k6 run perf/soak.js",
    "perf:throttler": "mkdir -p perf-results && k6 run perf/throttler.js",
    "perf:hpa": "bash perf/scripts/hpa-scale-test.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "sonar:up": "docker compose -f infra/sonar/docker-compose.sonar.yml up -d",
    "sonar:down": "docker compose -f infra/sonar/docker-compose.sonar.yml down",
    "sonar:local": "docker run --rm --add-host=host.docker.internal:host-gateway -e SONAR_HOST_URL=http://host.docker.internal:9000 -e SONAR_TOKEN=${SONAR_TOKEN} -v $(pwd):/usr/src sonarsource/sonar-scanner-cli:12.1"
  },
