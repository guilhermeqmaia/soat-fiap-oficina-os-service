    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "expect": "^30.5.2",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
