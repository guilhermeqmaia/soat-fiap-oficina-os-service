generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  /// CPF normalizado (so digitos) — chave do login staff na Lambda (US-F3-03/RFC-0003)
  cpf       String?  @unique
  senhaHash String   @map("senha_hash")
  role      Role
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ordensDeServico OrdemDeServico[]

  @@map("usuario")
}

enum Role {
  ADMIN
  ATENDENTE
  MECANICO
  ESTOQUISTA
  CLIENTE
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  cpfCnpj   String   @unique @map("cpf_cnpj")
  email     String?
  telefone  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  veiculos        Veiculo[]
  ordensDeServico OrdemDeServico[]

  @@map("cliente")
}

model Veiculo {
  id        String   @id @default(uuid())
  placa     String   @unique
  marca     String
  modelo    String
  ano       Int
  clienteId String   @map("cliente_id")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  ordensDeServico OrdemDeServico[]

  @@map("veiculo")
}

model OrdemDeServico {
  id                 String               @id @default(uuid())
  numero             String               @unique
  clienteId          String               @map("cliente_id")
  veiculoId          String               @map("veiculo_id")
  usuarioId          String?              @map("usuario_id")
  descricaoInicial   String               @map("descricao_inicial")
  diagnostico        String?
  status             StatusOrdemDeServico @default(RECEBIDA)
  /// Preenchido quando status=CANCELADA (compensacoes da saga — RFC-0005)
  motivoCancelamento String?              @map("motivo_cancelamento")
  /// Lock otimista: HTTP (cancelar/entregar) e callbacks dos participantes mutam a mesma OS
  version            Int      @default(0)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  itensServico ItemOrdemDeServicoServico[]
  auditLogs    OrdemDeServicoAuditLog[]

  @@map("ordem_de_servico")
}

model ItemOrdemDeServicoServico {
  id               String   @id @default(uuid())
  ordemDeServicoId String   @map("ordem_de_servico_id")
  /// Referencia do servico no catalogo do Execucao Service (sem FK: snapshot — RFC-0004)
  servicoId        String   @map("servico_id")
  nome             String
  quantidade       Int
  precoUnitario    Decimal  @map("preco_unitario")
  createdAt        DateTime @default(now()) @map("created_at")

  ordemDeServico OrdemDeServico              @relation(fields: [ordemDeServicoId], references: [id], onDelete: Cascade)
  produtos       ItemOrdemDeServicoProduto[]

  @@unique([ordemDeServicoId, servicoId])
  @@map("item_ordem_de_servico_servico")
}

model ItemOrdemDeServicoProduto {
  id                          String   @id @default(uuid())
  itemOrdemDeServicoServicoId String   @map("item_ordem_de_servico_servico_id")
  /// Referencia do produto no catalogo/estoque do Execucao Service (sem FK: snapshot)
  produtoId                   String   @map("produto_id")
  nome                        String
  quantidade                  Int
  precoUnitario               Decimal  @map("preco_unitario")
  createdAt                   DateTime @default(now()) @map("created_at")

  itemOrdemDeServicoServico ItemOrdemDeServicoServico @relation(fields: [itemOrdemDeServicoServicoId], references: [id], onDelete: Cascade)

  @@unique([itemOrdemDeServicoServicoId, produtoId])
  @@map("item_ordem_de_servico_produto")
}

enum StatusOrdemDeServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  AGUARDANDO_PAGAMENTO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
  CANCELADA
}

model OrdemDeServicoAuditLog {
  id               String   @id @default(uuid())
  ordemDeServicoId String   @map("ordem_de_servico_id")
  acao             String
  statusAnterior   String?  @map("status_anterior")
  statusNovo       String?  @map("status_novo")
  usuarioId        String?  @map("usuario_id")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  ordemDeServico OrdemDeServico @relation(fields: [ordemDeServicoId], references: [id], onDelete: Cascade)

  @@index([ordemDeServicoId, createdAt])
  @@map("ordem_de_servico_audit_log")
}

model Notificacao {
  id               String            @id @default(uuid())
  clienteId        String            @map("cliente_id")
  ordemDeServicoId String?           @map("ordem_de_servico_id")
  /// Numero da OS (US-F4-12) — legivel para o cliente e chave de correlacao da saga.
  numeroOS         String?           @map("numero_os")
  /// Id do fato que originou a notificacao (id do envelope do callback ou id deterministico).
  eventoId         String?           @map("evento_id")
  /// Link de pagamento do Mercado Pago (`billing.cobranca-criada`).
  linkPagamento    String?           @map("link_pagamento")
  tipo             TipoNotificacao
  canal            CanalNotificacao
  destinatario     String
  assunto          String
  mensagem         String
  status           StatusNotificacao
  erro             String?
  enviadaEm        DateTime?         @map("enviada_em")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([clienteId])
  @@index([ordemDeServicoId])
  @@index([numeroOS])
  // Idempotencia (US-F4-12): no maximo UMA notificacao por (fato, tipo, canal).
  // - evento_id e o fato (id do envelope do callback ou id deterministico); nao
  //   (tipo, OS), porque alguns fatos se repetem legitimamente na mesma OS:
  //   cada pagamento recusado e cada nova cobranca (outro orderId/link) devem avisar.
  // - tipo entra porque um mesmo fato gera mais de um tipo (billing.pagamento-aprovado
  //   -> PAGAMENTO_APROVADO + OS_FINALIZADA).
  // - canal entra para que o mesmo fato possa sair por e-mail E por webhook.
  // Linhas antigas (evento_id NULL) nao conflitam: NULLs sao distintos no Postgres.
  @@unique([eventoId, tipo, canal], map: "notificacao_evento_id_tipo_canal_key")
  @@map("notificacao")
}

enum TipoNotificacao {
  ORCAMENTO_PRONTO
  OS_FINALIZADA
  STATUS_OS_ALTERADO
  ORCAMENTO_APROVADO
  PAGAMENTO_PENDENTE
  PAGAMENTO_APROVADO
  PAGAMENTO_RECUSADO
  OS_CANCELADA
}

enum CanalNotificacao {
  EMAIL
  WEBHOOK
}

enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHOU
}

// ─── Callbacks HTTP dos participantes (RFC-0008) ───

/// Deduplicacao dos callbacks `POST /ordens-servico/:numero/eventos`: `id` do envelope ja aplicado.
/// Repeticao devolve `200 { aplicado: false, duplicado: true }`. Purgado apos CALLBACKS_RETENCAO_DIAS.
model ProcessedMessage {
  id           String   @id
  type         String
  processadaEm DateTime @default(now()) @map("processada_em")

  @@index([processadaEm])
  @@map("processed_messages")
}

// ─── Saga orquestrada da OS (RFC-0005 / US-F4-10) ───

/// Estado persistido da saga de cada OS: passo atual, historico de passos/eventos,
/// compensacoes enviadas/confirmadas e prazos (timeouts). Consultavel em
/// GET /ordens-servico/:numero/saga.
model SagaOS {
  id                String    @id @default(uuid())
  numero            String    @unique
  clienteId         String    @map("cliente_id")
  veiculoId         String    @map("veiculo_id")
  descricaoProblema String    @map("descricao_problema")
  passo             String
  status            String
  /// Quando entrou no passo atual (duracao por passo; alerta de saga parada)
  passoDesde        DateTime  @default(now()) @map("passo_desde")
  historico         Json      @default("[]")
  compensacoes      Json      @default("[]")
  prazoAprovacao    DateTime? @map("prazo_aprovacao")
  prazoPagamento    DateTime? @map("prazo_pagamento")
  /// Demo (US-F4-11): passo em que a saga simula a falha do participante
  falhaSimulada     String?   @map("falha_simulada")
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status, prazoAprovacao])
  @@index([status, prazoPagamento])
  @@index([status, passoDesde])
  @@map("saga_os")
}
